<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BetterSteamAuth.App.ViewModels"
        xmlns:views="using:BetterSteamAuth.App.Views"
        xmlns:res="using:BetterSteamAuth.App.Resources"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="BetterSteamAuth.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{x:Static res:Strings.AppName}"
        Icon="avares://BetterSteamAuth/Assets/app.ico"
        Width="900" Height="600" MinWidth="420" MinHeight="420"
        ExtendClientAreaToDecorationsHint="True">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:FirstRunViewModel"><views:FirstRunView /></DataTemplate>
    <DataTemplate DataType="vm:UnlockViewModel"><views:UnlockView /></DataTemplate>
    <DataTemplate DataType="vm:DataTooNewViewModel"><views:DataTooNewView /></DataTemplate>
    <DataTemplate DataType="vm:ImportViewModel"><views:ImportView /></DataTemplate>
    <DataTemplate DataType="vm:MainViewModel"><views:MainView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:SetupSettingsViewModel"><views:SetupSettingsView /></DataTemplate>
    <DataTemplate DataType="vm:PasswordViewModel"><views:PasswordView /></DataTemplate>
    <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="vm:ProxiesViewModel"><views:ProxiesView /></DataTemplate>
    <DataTemplate DataType="vm:ChangeProxyViewModel"><views:ChangeProxyView /></DataTemplate>
    <DataTemplate DataType="vm:LinkViewModel"><views:LinkView /></DataTemplate>
    <DataTemplate DataType="vm:ExportViewModel"><views:ExportView /></DataTemplate>
    <DataTemplate DataType="vm:BackupViewModel"><views:BackupView /></DataTemplate>
    <DataTemplate DataType="vm:RestoreViewModel"><views:RestoreView /></DataTemplate>
    <DataTemplate DataType="vm:RemovedAccountsViewModel"><views:RemovedAccountsView /></DataTemplate>
    <DataTemplate DataType="vm:RemoveAuthenticatorViewModel"><views:RemoveAuthenticatorView /></DataTemplate>
    <DataTemplate DataType="vm:AccountDetailsViewModel"><views:AccountDetailsView /></DataTemplate>
    <DataTemplate DataType="vm:AutomationViewModel"><views:AutomationView /></DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel"><views:HistoryView /></DataTemplate>
  </Window.DataTemplates>
  <DockPanel>
    <!-- Our own title bar: the app's background instead of the system's, with Windows' own caption buttons
         (and snap layouts) on the right. Dragging it moves the window. -->
    <Border DockPanel.Dock="Top" Classes="title-bar" chrome:WindowDecorationProperties.ElementRole="TitleBar"
            Height="{Binding $parent[Window].WindowDecorationMargin.Top}">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
        <Image Width="16" Height="16" Source="avares://BetterSteamAuth/Assets/app.ico" />
        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{x:Static res:Strings.AppName}" />
      </StackPanel>
    </Border>
    <!-- Something went wrong: {message} · Close -->
    <Border DockPanel.Dock="Bottom" Classes="divider-top bar" Padding="16,8" IsVisible="{Binding HasUnexpectedError}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <PathIcon Width="14" Height="14" VerticalAlignment="Center" Classes="danger" Data="{StaticResource SemiIconAlertCircle}" />
        <SelectableTextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding UnexpectedError}" />
        <Button Grid.Column="2" Theme="{DynamicResource BorderlessButton}" Content="{x:Static res:Strings.Dismiss}"
                Command="{Binding DismissUnexpectedErrorCommand}" />
      </Grid>
    </Border>
    <ContentControl Content="{Binding CurrentPage}" />
  </DockPanel>
</Window>
