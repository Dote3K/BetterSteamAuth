<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BetterSteamAuth.App.ViewModels"
        xmlns:views="using:BetterSteamAuth.App.Views"
        xmlns:res="using:BetterSteamAuth.App.Resources"
        x:Class="BetterSteamAuth.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{x:Static res:Strings.AppName}"
        Width="900" Height="600" MinWidth="420" MinHeight="420">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:FirstRunViewModel"><views:FirstRunView /></DataTemplate>
    <DataTemplate DataType="vm:UnlockViewModel"><views:UnlockView /></DataTemplate>
    <DataTemplate DataType="vm:ImportViewModel"><views:ImportView /></DataTemplate>
    <DataTemplate DataType="vm:MainViewModel"><views:MainView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="vm:ProxiesViewModel"><views:ProxiesView /></DataTemplate>
    <DataTemplate DataType="vm:ChangeProxyViewModel"><views:ChangeProxyView /></DataTemplate>
    <DataTemplate DataType="vm:LinkViewModel"><views:LinkView /></DataTemplate>
  </Window.DataTemplates>
  <ContentControl Content="{Binding CurrentPage}" />
</Window>
