<!-- One confirmation row, shared by the detail pane and the inbox. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:views="using:BetterSteamAuth.App.Views"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             x:Class="BetterSteamAuth.App.Views.ConfirmationRow"
             x:DataType="vm:ConfirmationItemViewModel">
  <Border Classes.danger-row="{Binding IsDangerous}" Background="Transparent" Cursor="Hand">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
      <Border Classes="conf-icon" VerticalAlignment="Center">
        <Panel>
          <PathIcon Width="16" Height="16" Classes="secondary" Data="{StaticResource SemiIconSync}" IsVisible="{Binding IsTrade}" />
          <PathIcon Width="16" Height="16" Classes="secondary" Data="{StaticResource SemiIconShoppingBag}" IsVisible="{Binding IsMarket}" />
          <PathIcon Width="16" Height="16" Classes="danger" Data="{StaticResource SemiIconKey}" IsVisible="{Binding IsDangerous}" />
        </Panel>
      </Border>

      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Headline}" />
          <TextBlock Grid.Column="1" Classes="caption hint" Text="{Binding Meta}"
                     IsVisible="{Binding !$parent[views:ConfirmationRow].ShowAccount}" />
          <TextBlock Grid.Column="1" Classes="caption hint" Text="{Binding MetaWithAccount}"
                     IsVisible="{Binding $parent[views:ConfirmationRow].ShowAccount}" />
        </Grid>
        <TextBlock Classes="caption" TextWrapping="Wrap" MaxLines="2" Text="{Binding Summary}" />

        <!-- Line 3: only when something needs attention -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasWarning}">
          <PathIcon Width="12" Height="12" VerticalAlignment="Top" Margin="0,2,0,0" Classes="warning" Data="{StaticResource SemiIconAlertTriangle}" />
          <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap" Text="{Binding Warning}" />
        </Grid>
        <TextBlock Classes="caption danger" TextWrapping="Wrap" Text="{x:Static res:Strings.DangerousHint}"
                   IsVisible="{Binding IsDangerous}" />
        <TextBlock Classes="caption danger" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Trade that needs review: confirm inline -->
        <StackPanel Spacing="6" Margin="0,6,0,0" IsVisible="{Binding IsConfirmingTrade}">
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding TradeConfirmText}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="Small" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelTradeCommand}" />
            <Button Classes="Small Primary" Theme="{DynamicResource SolidButton}"
                    Content="{x:Static res:Strings.AcceptTrade}" Command="{Binding AcceptCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- Undo window -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" IsVisible="{Binding IsPending}">
          <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding PendingText}" />
          <Button Theme="{DynamicResource BorderlessButton}" Classes="Small Primary" Padding="4,0"
                  Content="{x:Static res:Strings.Undo}" Command="{Binding UndoCommand}" IsVisible="{Binding ShowOwnUndo}" />
        </StackPanel>
        <TextBlock Classes="caption" Text="{x:Static res:Strings.Sending}" IsVisible="{Binding IsSending}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsIdle}">
        <Button Classes="quick accept" Command="{Binding AcceptCommand}"
                AutomationProperties.Name="{x:Static res:Strings.Accept}" ToolTip.Tip="{x:Static res:Strings.Accept}">
          <PathIcon Width="14" Height="14" Data="{StaticResource SemiIconTick}" />
        </Button>
        <Button Classes="quick reject" Command="{Binding RejectCommand}"
                AutomationProperties.Name="{x:Static res:Strings.Reject}" ToolTip.Tip="{x:Static res:Strings.Reject}">
          <PathIcon Width="14" Height="14" Data="{StaticResource SemiIconClose}" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
