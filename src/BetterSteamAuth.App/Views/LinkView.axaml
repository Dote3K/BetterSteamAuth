<!-- Link a new authenticator, or move one here. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             x:Class="BetterSteamAuth.App.Views.LinkView"
             x:DataType="vm:LinkViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <ScrollViewer>
    <Grid Width="420" Margin="24" VerticalAlignment="Center">

      <!-- 1. Sign in -->
      <StackPanel Spacing="8" IsVisible="{Binding IsSignIn}">
        <TextBlock Classes="heading" Text="{Binding Title}" />
        <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding SignInSubtitle}" />
        <TextBox PlaceholderText="{x:Static res:Strings.AccountName}" Text="{Binding AccountName}" IsEnabled="{Binding IsIdle}"
                 AutomationProperties.Name="{x:Static res:Strings.AccountName}" />
        <TextBox Classes="revealPasswordButton" PasswordChar="•" PlaceholderText="{x:Static res:Strings.Password}"
                 Text="{Binding Password}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{x:Static res:Strings.Password}" />

        <CheckBox Margin="0,4,0,0" Content="{x:Static res:Strings.UseAProxy}" IsChecked="{Binding UseProxy}" IsEnabled="{Binding IsIdle}" />
        <StackPanel Spacing="6" Margin="28,0,0,0" IsVisible="{Binding UseProxy}">
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ProxyChoices}" SelectedItem="{Binding SelectedProxy}"
                    IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{x:Static res:Strings.UseAProxy}" />
          <StackPanel Spacing="4" IsVisible="{Binding IsNewProxy}">
            <TextBox FontFamily="{StaticResource Bsa.Font.Code}" PlaceholderText="{x:Static res:Strings.ProxyPlaceholder}"
                     Text="{Binding NewProxy}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{x:Static res:Strings.PasteNewProxy}" />
            <TextBlock Classes="caption" Classes.danger="{Binding NewProxyIsError}" Classes.hint="{Binding !NewProxyIsError}"
                       Text="{Binding NewProxyPreview}"
                       IsVisible="{Binding NewProxyPreview, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </StackPanel>

        <TextBlock Classes="danger" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
        <!-- The account turned out to need the other flow; the sign-in is kept -->
        <Button HorizontalAlignment="Left" Theme="{DynamicResource BorderlessButton}" Classes="Primary" Padding="0"
                Content="{x:Static res:Strings.MoveItHere}" Command="{Binding MoveHereCommand}" IsVisible="{Binding CanMoveHere}" />
        <Button HorizontalAlignment="Left" Theme="{DynamicResource BorderlessButton}" Classes="Primary" Padding="0"
                Content="{x:Static res:Strings.LinkNewAuthenticator}" Command="{Binding LinkInsteadCommand}" IsVisible="{Binding CanLinkInstead}" />
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
          <Button Grid.Column="2" Theme="{DynamicResource SolidButton}" Classes="Primary" IsDefault="True"
                  Content="{Binding ContinueLabel}" Command="{Binding SignInCommand}" IsEnabled="{Binding IsIdle}" />
        </Grid>
      </StackPanel>

      <!-- Sign-in Steam Guard: an emailed code, or the phone's code / approval when moving -->
      <StackPanel Spacing="8" IsVisible="{Binding IsEmailCode}">
        <TextBlock Classes="heading" Text="{Binding GuardTitle}" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding GuardPrompt}" />
        <TextBox PlaceholderText="{Binding GuardPlaceholder}" Text="{Binding EmailCode}"
                 AutomationProperties.Name="{Binding GuardPlaceholder}" />
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
          <Button Grid.Column="2" Theme="{DynamicResource SolidButton}" Classes="Primary" IsDefault="True"
                  Content="{x:Static res:Strings.Continue}" Command="{Binding SubmitEmailCodeCommand}" />
        </Grid>
      </StackPanel>

      <!-- Resuming: checking with Steam -->
      <StackPanel Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding IsChecking}">
        <TextBlock Classes="secondary" HorizontalAlignment="Center" Text="{x:Static res:Strings.LinkCheckingStatus}" />
      </StackPanel>

      <!-- Move: send a text -->
      <StackPanel Spacing="8" IsVisible="{Binding IsMoveSend}">
        <TextBlock Classes="heading" Text="{x:Static res:Strings.MoveSendTitle}" />
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding MoveSendBody}" />
        <Button HorizontalAlignment="Left" Theme="{DynamicResource BorderlessButton}" Classes="Primary" Padding="0" Margin="0,0,0,8"
                Content="{x:Static res:Strings.AboutTradeHolds}" Command="{Binding OpenTradeHoldsCommand}" />
        <TextBlock Classes="danger" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
          <Button Grid.Column="2" Theme="{DynamicResource SolidButton}" Classes="Primary" IsDefault="True"
                  Content="{Binding SendTextLabel}" Command="{Binding SendTextCommand}" IsEnabled="{Binding IsIdle}" />
        </Grid>
      </StackPanel>

      <!-- Move: enter the texted code -->
      <StackPanel Spacing="8" IsVisible="{Binding IsMoveCode}">
        <TextBlock Classes="heading" Text="{x:Static res:Strings.MoveCodeTitle}" />
        <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding MoveCodeSubtitle}" />
        <TextBox PlaceholderText="{x:Static res:Strings.SmsCode}" Text="{Binding SmsCode}" IsEnabled="{Binding IsIdle}"
                 FontFamily="{StaticResource Bsa.Font.Code}" AutomationProperties.Name="{x:Static res:Strings.SmsCode}" />
        <TextBlock Classes="danger" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
        <!-- The move went through but saving failed: never lose the only copy -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SaveFailed}">
          <Button Theme="{DynamicResource SolidButton}" Classes="Primary" Content="{x:Static res:Strings.TryAgain}" Command="{Binding RetrySaveCommand}" />
          <Button Content="{x:Static res:Strings.SaveAsFile}" Command="{Binding SaveAsFileCommand}" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,0" IsVisible="{Binding CanCancel}">
          <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
          <Button Grid.Column="2" Theme="{DynamicResource BorderlessButton}" Classes="Primary"
                  Content="{Binding SendAgainLabel}" Command="{Binding SendAgainCommand}" IsEnabled="{Binding CanSendAgain}" />
          <Button Grid.Column="3" Theme="{DynamicResource SolidButton}" Classes="Primary" IsDefault="True"
                  Content="{Binding MoveLabel}" Command="{Binding MoveCommand}" IsEnabled="{Binding IsIdle}" />
        </Grid>
      </StackPanel>

      <!-- 2. Revocation code -->
      <StackPanel Spacing="8" IsVisible="{Binding IsRevocation}">
        <TextBlock Classes="heading" Text="{x:Static res:Strings.RevocationTitle}" />
        <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding RevocationSubtitle}" />
        <Border Classes="well" Padding="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="code-large" VerticalAlignment="Center" Text="{Binding RevocationCode}" />
            <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding CopyRevocationCodeCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Copy}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="14" Height="14" Data="{StaticResource SemiIconCopy}" />
                <TextBlock Text="{x:Static res:Strings.Copy}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <CheckBox Margin="0,8,0,0" Content="{x:Static res:Strings.SavedRevocationCode}" IsChecked="{Binding SavedRevocationCode}" />
        <TextBlock Classes="danger" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
          <Button Grid.Column="2" Theme="{DynamicResource SolidButton}" Classes="Primary"
                  Content="{x:Static res:Strings.Continue}" Command="{Binding ContinueToActivateCommand}" />
        </Grid>
      </StackPanel>

      <!-- 3. Activate -->
      <StackPanel Spacing="8" IsVisible="{Binding IsActivate}">
        <TextBlock Classes="heading" Text="{x:Static res:Strings.ActivateTitle}" />
        <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding ActivationHint}" />
        <TextBox PlaceholderText="{x:Static res:Strings.ActivationCode}" Text="{Binding ActivationCode}" IsEnabled="{Binding IsIdle}"
                 FontFamily="{StaticResource Bsa.Font.Code}" AutomationProperties.Name="{x:Static res:Strings.ActivationCode}" />
        <TextBlock Classes="danger" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,0">
          <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
          <Button Grid.Column="2" Theme="{DynamicResource BorderlessButton}" Classes="Primary"
                  Content="{x:Static res:Strings.StartOver}" Command="{Binding StartOverCommand}" IsVisible="{Binding CanStartOver}" />
          <Button Grid.Column="3" Theme="{DynamicResource SolidButton}" Classes="Primary" IsDefault="True"
                  Content="{Binding ActivateLabel}" Command="{Binding ActivateCommand}" IsEnabled="{Binding IsIdle}" />
        </Grid>
      </StackPanel>

      <!-- 4. Done -->
      <StackPanel Spacing="8" IsVisible="{Binding IsDone}">
        <PathIcon Width="40" Height="40" Classes="success" Data="{StaticResource SemiIconTickCircle}" />
        <TextBlock Classes="heading" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding DoneTitle}" />
        <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding DoneBody}" />
        <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding DoneNote}"
                   IsVisible="{Binding DoneNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Classes="code-large" HorizontalAlignment="Center" Margin="0,8,0,0" Text="{Binding CurrentCode}" />
        <Button Margin="0,12,0,0" HorizontalAlignment="Center" Theme="{DynamicResource SolidButton}" Classes="Primary"
                Content="{x:Static res:Strings.OpenApp}" Command="{Binding OpenCommand}" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
