<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             x:Class="BetterSteamAuth.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
  </UserControl.KeyBindings>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="divider-bottom" Padding="16,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Theme="{DynamicResource BorderlessButton}" Padding="8" Command="{Binding BackCommand}"
                AutomationProperties.Name="{x:Static res:Strings.Back}" ToolTip.Tip="{x:Static res:Strings.Back}">
          <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconArrowLeft}" />
        </Button>
        <TextBlock Classes="title" VerticalAlignment="Center" Text="{x:Static res:Strings.Settings}" />
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel MaxWidth="640" Margin="24,20" Spacing="4" HorizontalAlignment="Stretch">
        <TextBlock Classes="caption" Text="{x:Static res:Strings.Confirmations}" Margin="0,0,0,8" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,28">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.AcceptTradesInBulk}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.AcceptTradesInBulkBody}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding AcceptTradesInBulk}"
                        AutomationProperties.Name="{x:Static res:Strings.AcceptTradesInBulk}" />
        </Grid>

        <TextBlock Classes="caption" Text="{x:Static res:Strings.AdvancedNetwork}" Margin="0,0,0,8" />

        <Grid ColumnDefinitions="*,160" ColumnSpacing="24" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.BypassSni}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.BypassSniBody}" />
          </StackPanel>
          <ComboBox Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding SniBypassChoices}" SelectedItem="{Binding SniBypass}" />
        </Grid>

        <Grid ColumnDefinitions="*,160" ColumnSpacing="24">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.EncryptedDns}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.EncryptedDnsBody}" />
          </StackPanel>
          <ComboBox Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding EncryptedDnsChoices}" SelectedItem="{Binding EncryptedDns}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
