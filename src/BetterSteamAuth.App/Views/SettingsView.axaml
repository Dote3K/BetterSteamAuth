<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             x:Class="BetterSteamAuth.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
  </UserControl.KeyBindings>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="divider-bottom" Padding="16,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Theme="{DynamicResource BorderlessButton}" Padding="8" Command="{Binding BackCommand}"
                AutomationProperties.Name="{x:Static res:Strings.Back}" ToolTip.Tip="{x:Static res:Strings.Back}">
          <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconArrowLeft}" />
        </Button>
        <TextBlock Classes="title" VerticalAlignment="Center" Text="{x:Static res:Strings.Settings}" />
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel MaxWidth="640" Margin="24,20" Spacing="4" HorizontalAlignment="Stretch">
        <TextBlock Classes="caption" Text="{x:Static res:Strings.Security}" Margin="0,0,0,8" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.AppPassword}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding PasswordBody}" />
            <TextBlock Classes="success" TextWrapping="Wrap" Text="{Binding PasswordNotice}" IsVisible="{Binding HasPasswordNotice}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Top" Content="{Binding PasswordButton}" Command="{Binding OpenPasswordCommand}" />
        </Grid>
        <Border Height="12" IsVisible="{Binding !HasPassword}" />
        <StackPanel Spacing="4" IsVisible="{Binding HasPassword}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,16" IsVisible="{Binding CanRemember}">
            <StackPanel Spacing="2">
              <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.RememberOnDevice}" />
              <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.RememberOnDeviceBody}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding RememberOnDevice}"
                          AutomationProperties.Name="{x:Static res:Strings.RememberOnDevice}" />
          </Grid>
          <Grid ColumnDefinitions="*,160" ColumnSpacing="24" Margin="0,0,0,28">
            <StackPanel Spacing="2">
              <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.AutoLock}" />
              <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.AutoLockBody}" />
            </StackPanel>
            <ComboBox Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AutoLockChoices}" SelectedItem="{Binding AutoLock}"
                      AutomationProperties.Name="{x:Static res:Strings.AutoLock}" />
          </Grid>
        </StackPanel>

        <TextBlock Classes="caption" Text="{x:Static res:Strings.Confirmations}" Margin="0,0,0,8" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.AcceptTradesInBulk}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.AcceptTradesInBulkBody}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding AcceptTradesInBulk}"
                        AutomationProperties.Name="{x:Static res:Strings.AcceptTradesInBulk}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,28">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.CheckInBackground}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.CheckInBackgroundBody}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding CheckInBackground}"
                        AutomationProperties.Name="{x:Static res:Strings.CheckInBackground}" />
        </Grid>

        <!-- Data: backups, restore, export, removed accounts. -->
        <TextBlock Classes="caption" Text="{x:Static res:Strings.Data}" Margin="0,0,0,8" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.BackUpTitle}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding BackupDetail}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Top" Content="{x:Static res:Strings.BackUpMenu}" Command="{Binding OpenBackupCommand}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.RestoreFromBackup}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.RestoreBody}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Top" Content="{x:Static res:Strings.RestoreMenu}" Command="{Binding OpenRestoreCommand}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.ExportForSda}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.ExportSettingsBody}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Top" Content="{x:Static res:Strings.ExportMenu}" Command="{Binding OpenExportCommand}" />
        </Grid>
        <!-- Automatic backups: optional, only with an app password, only when data changed -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.AutoBackupTitle}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.AutoBackupBody}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.AutoBackupNeedsPassword}"
                       IsVisible="{Binding AutoBackupUnavailable}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding AutoBackupEnabled}" IsEnabled="{Binding AutoBackupAvailable}"
                        AutomationProperties.Name="{x:Static res:Strings.AutoBackupTitle}" />
        </Grid>
        <StackPanel Spacing="4" Margin="20,0,0,16" IsVisible="{Binding AutoBackupEnabled}">
          <Grid ColumnDefinitions="*,200" ColumnSpacing="24" Margin="0,0,0,12">
            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static res:Strings.AutoBackupWhen}" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding FrequencyChoices}" SelectedItem="{Binding AutoBackupFrequency}"
                      AutomationProperties.Name="{x:Static res:Strings.AutoBackupWhen}" />
          </Grid>
          <Grid ColumnDefinitions="*,200" ColumnSpacing="24" Margin="0,0,0,12">
            <StackPanel Spacing="2">
              <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.AutoBackupKeep}" />
              <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.AutoBackupKeepBody}" />
            </StackPanel>
            <ComboBox Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" ItemsSource="{Binding KeepChoices}" SelectedItem="{Binding AutoBackupKeep}"
                      AutomationProperties.Name="{x:Static res:Strings.AutoBackupKeep}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <StackPanel Spacing="2">
              <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.AutoBackupFolder}" />
              <TextBlock Classes="secondary" TextTrimming="CharacterEllipsis" Text="{Binding AutoBackupFolder}" ToolTip.Tip="{Binding AutoBackupFolder}" />
              <TextBlock Classes="caption secondary" Text="{Binding LastAutoBackupText}" IsVisible="{Binding HasLastAutoBackup}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Top" Content="{x:Static res:Strings.Change}" Command="{Binding ChangeAutoBackupFolderCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.ChooseBackupFolder}" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding HasRemoved}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,16">
            <StackPanel Spacing="2">
              <TextBlock FontWeight="SemiBold" Text="{Binding RemovedLabel}" />
              <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.RemovedAccountsBody}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Top" Content="{x:Static res:Strings.Open}" Command="{Binding OpenRemovedCommand}"
                    AutomationProperties.Name="{Binding RemovedLabel}" />
          </Grid>
        </StackPanel>
        <Border Height="12" />

        <!-- Updates. -->
        <TextBlock Classes="caption" Text="{x:Static res:Strings.Updates}" Margin="0,0,0,8" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static vm:SettingsViewModel.VersionText}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding UpdateStatusText}" IsVisible="{Binding HasUpdateStatus}" />
            <Expander Header="{x:Static res:Strings.Details}" IsVisible="{Binding HasUpdateDetails}" Margin="0,4,0,0">
              <SelectableTextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding UpdateDetails}" />
            </Expander>
          </StackPanel>
          <Panel Grid.Column="1" VerticalAlignment="Top">
            <Button Content="{x:Static res:Strings.CheckNow}" Command="{Binding CheckForUpdatesCommand}"
                    IsEnabled="{Binding CanCheckForUpdates}" IsVisible="{Binding !IsUpdateReady}" />
            <Button Classes="Primary" Theme="{DynamicResource SolidButton}" Content="{x:Static res:Strings.RestartToUpdate}"
                    Command="{Binding RestartToUpdateCommand}" IsVisible="{Binding IsUpdateReady}" />
          </Panel>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.CheckForUpdatesAuto}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.CheckForUpdatesAutoBody}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding AutoCheckUpdates}"
                        AutomationProperties.Name="{x:Static res:Strings.CheckForUpdatesAuto}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,28">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.IncludeBeta}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.IncludeBetaBody}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding IncludeBetaUpdates}"
                        AutomationProperties.Name="{x:Static res:Strings.IncludeBeta}" />
        </Grid>

        <TextBlock Classes="caption" Text="{x:Static res:Strings.AdvancedNetwork}" Margin="0,0,0,8" />

        <Grid ColumnDefinitions="*,160" ColumnSpacing="24" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.BypassSni}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.BypassSniBody}" />
          </StackPanel>
          <ComboBox Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding SniBypassChoices}" SelectedItem="{Binding SniBypass}" />
        </Grid>

        <Grid ColumnDefinitions="*,160" ColumnSpacing="24">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.EncryptedDns}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.EncryptedDnsBody}" />
          </StackPanel>
          <ComboBox Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding EncryptedDnsChoices}" SelectedItem="{Binding EncryptedDns}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
