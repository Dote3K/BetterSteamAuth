<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             x:Class="BetterSteamAuth.App.Views.ChangeProxyView"
             x:DataType="vm:ChangeProxyViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <StackPanel Width="420" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Classes="heading" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
    <ListBox MaxHeight="320" Margin="0,8,0,0" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ProxyOption">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" Classes.mono="{Binding IsProxy}" Text="{Binding Label}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="caption" Classes.danger="{Binding IsDead}" Text="{Binding Detail}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
      <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
      <Button Grid.Column="2" Theme="{DynamicResource SolidButton}" Classes="Primary" IsDefault="True"
              Content="{x:Static res:Strings.Save}" Command="{Binding SaveCommand}" />
    </Grid>
  </StackPanel>
</UserControl>
