<!-- Settings → App password: change it, or set one on plain data. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             x:Class="BetterSteamAuth.App.Views.PasswordView"
             x:DataType="vm:PasswordViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
  </UserControl.KeyBindings>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="divider-bottom" Padding="16,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Theme="{DynamicResource BorderlessButton}" Padding="8" Command="{Binding BackCommand}"
                AutomationProperties.Name="{x:Static res:Strings.Back}" ToolTip.Tip="{x:Static res:Strings.Back}">
          <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconArrowLeft}" />
        </Button>
        <TextBlock Classes="title" VerticalAlignment="Center" Text="{Binding Title}" />
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Width="360" Margin="24" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
        <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding Body}" />
        <TextBox Classes="revealPasswordButton" PasswordChar="•" IsVisible="{Binding IsChange}"
                 PlaceholderText="{x:Static res:Strings.CurrentPassword}" Text="{Binding CurrentPassword}"
                 AutomationProperties.Name="{x:Static res:Strings.CurrentPassword}" />
        <TextBox Classes="revealPasswordButton" PasswordChar="•"
                 PlaceholderText="{x:Static res:Strings.NewPassword}" Text="{Binding NewPassword}"
                 AutomationProperties.Name="{x:Static res:Strings.NewPassword}" />
        <TextBox Classes="revealPasswordButton" PasswordChar="•"
                 PlaceholderText="{x:Static res:Strings.ConfirmPassword}" Text="{Binding ConfirmPassword}"
                 AutomationProperties.Name="{x:Static res:Strings.ConfirmPassword}" />
        <TextBlock Classes="danger" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <CheckBox Margin="0,4,0,0" IsChecked="{Binding RememberOnDevice}" IsVisible="{Binding CanRemember}"
                  Content="{x:Static res:Strings.RememberOnDevice}" ToolTip.Tip="{x:Static res:Strings.RememberOnDeviceBody}" />
        <Button HorizontalAlignment="Right" Margin="0,12,0,0" Theme="{DynamicResource SolidButton}" Classes="Primary" IsDefault="True"
                Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
