<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             x:Class="BetterSteamAuth.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">
  <Grid Width="460" Margin="24" VerticalAlignment="Center">
    <!-- Pick and select -->
    <DockPanel IsVisible="{Binding !IsDone}">
      <StackPanel DockPanel.Dock="Top" Spacing="8">
        <TextBlock Classes="heading" Text="{Binding Title}" />
        <TextBlock Classes="caption" TextTrimming="CharacterEllipsis" Text="{Binding SourceLabel}"
                   IsVisible="{Binding SourceLabel, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button HorizontalAlignment="Left" Command="{Binding PickCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="14" Height="14" Data="{StaticResource SemiIconFolderOpen}" />
            <TextBlock Text="{x:Static res:Strings.ChooseFolder}" IsVisible="{Binding IsSdaSource}" />
            <TextBlock Text="{x:Static res:Strings.ChooseFiles}" IsVisible="{Binding !IsSdaSource}" />
          </StackPanel>
        </Button>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding NeedsPasskey}">
          <TextBox Classes="revealPasswordButton" PasswordChar="•"
                   PlaceholderText="{x:Static res:Strings.SdaPasskey}" Text="{Binding Passkey}" />
          <Button Grid.Column="1" Content="{x:Static res:Strings.Unlock}" Command="{Binding UnlockSdaCommand}" IsDefault="True" />
        </Grid>
        <TextBlock Classes="danger" TextWrapping="Wrap" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
        <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
        <Button Grid.Column="2" Theme="{DynamicResource SolidButton}" Classes="Primary"
                IsVisible="{Binding HasItems}" Content="{Binding ImportButtonText}" Command="{Binding ImportCommand}" />
      </Grid>

      <ListBox Margin="0,12,0,0" MaxHeight="280" ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ImportItemViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanImport}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="caption"
                         Classes.danger="{Binding IsError}" Text="{Binding Problem}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Done -->
    <StackPanel Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding IsDone}">
      <PathIcon Width="40" Height="40" Classes="success" Data="{StaticResource SemiIconTickCircle}" />
      <TextBlock Classes="heading" HorizontalAlignment="Center" Text="{Binding DoneTitle}" />
      <TextBlock Classes="secondary" HorizontalAlignment="Center" Text="{Binding DoneSummary}"
                 IsVisible="{Binding DoneSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Button Margin="0,12,0,0" HorizontalAlignment="Center" Theme="{DynamicResource SolidButton}" Classes="Primary"
              Content="{x:Static res:Strings.OpenApp}" Command="{Binding FinishCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
