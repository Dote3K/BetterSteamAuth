<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             xmlns:v="using:BetterSteamAuth.App.Views"
             x:Class="BetterSteamAuth.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">
  <Grid Width="460" Margin="24" VerticalAlignment="Center">
    <!-- Pick and select -->
    <StackPanel Spacing="8" IsVisible="{Binding IsSelecting}">
      <TextBlock Classes="heading" Text="{Binding Title}" />
      <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding Subtitle}" />

      <!-- Source picker -->
      <Border Classes="well" Padding="16">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Button HorizontalAlignment="Center" Command="{Binding PickCommand}" AutomationProperties.Name="{Binding PickLabel}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="14" Height="14" Data="{StaticResource SemiIconFolderOpen}" />
              <TextBlock Text="{Binding PickLabel}" />
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" HorizontalAlignment="Center" MaxWidth="400" TextTrimming="CharacterEllipsis"
                     Text="{Binding SourceLabel}"
                     IsVisible="{Binding SourceLabel, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding NeedsPasskey}">
        <TextBox Classes="revealPasswordButton" PasswordChar="•"
                 PlaceholderText="{x:Static res:Strings.SdaPasskey}" Text="{Binding Passkey}" />
        <Button Grid.Column="1" Content="{x:Static res:Strings.Unlock}" Command="{Binding UnlockSdaCommand}" IsDefault="True" />
      </Grid>
      <TextBlock Classes="danger" TextWrapping="Wrap" Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <ListBox MaxHeight="260" ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ImportItemViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanImport}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="caption"
                         Classes.danger="{Binding IsError}" Text="{Binding Problem}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
        <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
        <Button Grid.Column="2" Theme="{DynamicResource SolidButton}" Classes="Primary"
                IsVisible="{Binding HasItems}" Content="{Binding ImportButtonText}" Command="{Binding ImportCommand}" />
      </Grid>
    </StackPanel>

    <!-- Connection: nothing is sent to Steam before Finish -->
    <StackPanel Spacing="8" IsVisible="{Binding IsConnection}">
      <TextBlock Classes="heading" Text="{x:Static res:Strings.ConnectionTitle}" />
      <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,12" Text="{x:Static res:Strings.ConnectionSubtitle}" />

      <RadioButton Theme="{DynamicResource CardRadioButton}" HorizontalAlignment="Stretch" GroupName="connection"
                   IsChecked="{Binding UseDirect}">
        <StackPanel Spacing="2">
          <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.DirectConnection}" />
          <TextBlock Classes="secondary" Text="{Binding DirectHint}" />
        </StackPanel>
      </RadioButton>
      <RadioButton Theme="{DynamicResource CardRadioButton}" HorizontalAlignment="Stretch" GroupName="connection"
                   IsChecked="{Binding UseProxies}">
        <StackPanel Spacing="2">
          <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.UseProxies}" />
          <TextBlock Classes="secondary" Text="{x:Static res:Strings.UseProxiesHint}" />
        </StackPanel>
      </RadioButton>

      <StackPanel Spacing="6" Margin="0,4,0,0" IsVisible="{Binding UseProxies}">
        <ScrollViewer MaxHeight="260">
          <v:ProxyPasteBox DataContext="{Binding Paste}" />
        </ScrollViewer>
        <TextBlock Classes="caption" Classes.danger="{Binding ProxySummaryIsError}" TextWrapping="Wrap"
                   Text="{Binding ProxySummary}" IsVisible="{Binding HasProxySummary}" />
      </StackPanel>

      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
        <Button Content="{x:Static res:Strings.Back}" Command="{Binding BackToSelectCommand}" />
        <Button Grid.Column="2" Theme="{DynamicResource SolidButton}" Classes="Primary"
                Content="{x:Static res:Strings.Finish}" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" />
      </Grid>
    </StackPanel>

    <!-- Done -->
    <StackPanel Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding IsDone}">
      <PathIcon Width="40" Height="40" Classes="success" Data="{StaticResource SemiIconTickCircle}" />
      <TextBlock Classes="heading" HorizontalAlignment="Center" Text="{Binding DoneTitle}" />
      <TextBlock Classes="secondary" HorizontalAlignment="Center" Text="{Binding DoneSummary}"
                 IsVisible="{Binding DoneSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Button Margin="0,12,0,0" HorizontalAlignment="Center" Theme="{DynamicResource SolidButton}" Classes="Primary"
              Content="{x:Static res:Strings.OpenApp}" Command="{Binding FinishCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
