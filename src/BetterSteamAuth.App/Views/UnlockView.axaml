<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             x:Class="BetterSteamAuth.App.Views.UnlockView"
             x:DataType="vm:UnlockViewModel">
  <StackPanel Width="300" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
    <PathIcon Width="32" Height="32" Classes="secondary" Data="{StaticResource SemiIconLock}" />
    <TextBlock Classes="heading" HorizontalAlignment="Center" Text="{x:Static res:Strings.UnlockTitle}" />
    <TextBlock Classes="secondary" HorizontalAlignment="Center" Margin="0,0,0,12" Text="{x:Static res:Strings.UnlockSubtitle}" />
    <TextBox x:Name="PasswordBox" Classes="revealPasswordButton" PasswordChar="•"
             PlaceholderText="{x:Static res:Strings.Password}" Text="{Binding Password}" />
    <TextBlock Classes="danger" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <Button HorizontalAlignment="Stretch" Theme="{DynamicResource SolidButton}" Classes="Primary" IsDefault="True"
            Content="{Binding UnlockLabel}" Command="{Binding UnlockCommand}" IsEnabled="{Binding !IsBusy}" />
    <Button HorizontalAlignment="Center" Theme="{DynamicResource BorderlessButton}" Margin="0,4,0,0"
            Content="{x:Static res:Strings.ForgotPassword}" Command="{Binding ForgotCommand}" IsVisible="{Binding !ShowsForgot}" />
    <Border Classes="well" Padding="14,12" Margin="0,8,0,0" IsVisible="{Binding ShowsForgot}">
      <StackPanel Spacing="10">
        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.ForgotPasswordBody}" />
        <Button HorizontalAlignment="Left" Content="{x:Static res:Strings.RestoreFromBackup}" Command="{Binding RestoreFromBackupCommand}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
