<!-- Confirmations inbox. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:views="using:BetterSteamAuth.App.Views"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             x:Class="BetterSteamAuth.App.Views.InboxView"
             x:DataType="vm:InboxViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>
  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Classes="divider-bottom" Padding="16,6">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Theme="{DynamicResource BorderlessButton}" Padding="8" Command="{Binding CloseCommand}"
                AutomationProperties.Name="{x:Static res:Strings.Back}" ToolTip.Tip="{x:Static res:Strings.Back}">
          <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconArrowLeft}" />
        </Button>
        <TextBlock Grid.Column="1" Classes="title" VerticalAlignment="Center" Text="{x:Static res:Strings.Confirmations}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                    IsVisible="{Binding HasFailed}" ToolTip.Tip="{Binding FailedNames}">
          <PathIcon Width="12" Height="12" VerticalAlignment="Center" Classes="warning" Data="{StaticResource SemiIconAlertCircle}" />
          <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding FailedText}" />
        </StackPanel>
        <Button Grid.Column="3" Theme="{DynamicResource BorderlessButton}" Padding="8" Command="{Binding RefreshCommand}"
                AutomationProperties.Name="{x:Static res:Strings.Refresh}" ToolTip.Tip="{x:Static res:Strings.Refresh}">
          <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconRefresh}" />
        </Button>
      </Grid>
    </Border>

    <!-- Filters: segments with nothing in them are hidden -->
    <Border DockPanel.Dock="Top" Classes="divider-bottom" Padding="24,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <RadioButton Theme="{DynamicResource ButtonRadioButton}" GroupName="inbox-filter" IsChecked="{Binding IsAll}" Content="{Binding AllLabel}" />
          <RadioButton Theme="{DynamicResource ButtonRadioButton}" GroupName="inbox-filter" IsChecked="{Binding IsTrades}" Content="{Binding TradesLabel}" IsVisible="{Binding HasTrades}" />
          <RadioButton Theme="{DynamicResource ButtonRadioButton}" GroupName="inbox-filter" IsChecked="{Binding IsMarket}" Content="{Binding MarketLabel}" IsVisible="{Binding HasMarket}" />
          <RadioButton Theme="{DynamicResource ButtonRadioButton}" GroupName="inbox-filter" IsChecked="{Binding IsAccount}" Content="{Binding AccountLabel}" IsVisible="{Binding HasAccountItems}" />
        </StackPanel>
        <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding SelectAll}" IsVisible="{Binding !IsEmpty}"
                  Content="{x:Static res:Strings.SelectAll}" />
      </Grid>
    </Border>

    <!-- Batch undo window -->
    <Border DockPanel.Dock="Bottom" Classes="divider-top bar" Padding="24,10" IsVisible="{Binding IsBatchPending}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock VerticalAlignment="Center" Text="{Binding BatchText}" />
        <Button Grid.Column="1" Content="{x:Static res:Strings.Undo}" Command="{Binding UndoBatchCommand}" />
      </Grid>
    </Border>

    <!-- Selection bar -->
    <Border DockPanel.Dock="Bottom" Classes="divider-top bar" Padding="24,10" IsVisible="{Binding ShowSelectionBar}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <TextBlock VerticalAlignment="Center" Text="{Binding SelectionText}" />
        <TextBlock Grid.Column="1" Classes="caption hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Margin="4,0,0,0" Text="{Binding SkipText}" />
        <Button Grid.Column="2" Content="{Binding RejectLabel}" Command="{Binding RejectSelectedCommand}" />
        <Button Grid.Column="3" Theme="{DynamicResource SolidButton}" Classes="Primary"
                Content="{Binding AcceptLabel}" Command="{Binding AcceptSelectedCommand}" IsEnabled="{Binding CanAcceptSelection}" />
      </Grid>
    </Border>

    <Panel>
      <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}">
        <TextBlock Classes="title" HorizontalAlignment="Center" Text="{x:Static res:Strings.AllCaughtUp}" />
        <TextBlock Classes="secondary" HorizontalAlignment="Center" Text="{x:Static res:Strings.AllCaughtUpBody}" />
      </StackPanel>

      <ScrollViewer IsVisible="{Binding !IsEmpty}">
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InboxEntryViewModel">
              <Border Classes="divider-bottom" Padding="24,16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                  <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}"
                            IsEnabled="{Binding Item.IsIdle}" AutomationProperties.Name="{Binding Item.Headline}" />
                  <views:ConfirmationRow Grid.Column="1" ShowAccount="True" DataContext="{Binding Item}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
