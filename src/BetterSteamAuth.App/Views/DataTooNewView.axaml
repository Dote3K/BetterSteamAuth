<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             x:Class="BetterSteamAuth.App.Views.DataTooNewView"
             x:DataType="vm:DataTooNewViewModel">
  <!-- Data saved by a newer version: nothing destructive here, only the update. -->
  <StackPanel Width="340" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
    <PathIcon Width="32" Height="32" Classes="warning" Data="{StaticResource SemiIconAlertTriangle}" />
    <TextBlock Classes="heading" HorizontalAlignment="Center" Text="{x:Static res:Strings.DataTooNewTitle}" />
    <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12" Text="{x:Static res:Strings.DataTooNewBody}" />
    <Button HorizontalAlignment="Stretch" Theme="{DynamicResource SolidButton}" Classes="Primary" IsDefault="True"
            Content="{x:Static res:Strings.CheckForUpdates}" Command="{Binding CheckForUpdatesCommand}"
            IsEnabled="{Binding CanCheck}" IsVisible="{Binding !IsUpdateReady}" />
    <Button HorizontalAlignment="Stretch" Theme="{DynamicResource SolidButton}" Classes="Primary"
            Content="{x:Static res:Strings.RestartToUpdate}" Command="{Binding RestartToUpdateCommand}" IsVisible="{Binding IsUpdateReady}" />
    <TextBlock Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
               Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" />
  </StackPanel>
</UserControl>
