<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             x:Class="BetterSteamAuth.App.Views.MainView"
             x:DataType="vm:MainViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+L" Command="{Binding LockCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCodeCommand}" />
  </UserControl.KeyBindings>
  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Classes="divider-bottom" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Classes="title" VerticalAlignment="Center" Text="{x:Static res:Strings.AllAccounts}" />
        <TextBox Grid.Column="1" MaxWidth="420" HorizontalAlignment="Stretch"
                 PlaceholderText="{x:Static res:Strings.Search}"
                 Text="{Binding SearchText}">
          <TextBox.InnerLeftContent>
            <PathIcon Width="14" Height="14" Margin="10,0,0,0" Data="{StaticResource SemiIconSearch}" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <Button Grid.Column="2" Theme="{DynamicResource BorderlessButton}" Padding="8"
                AutomationProperties.Name="{x:Static res:Strings.More}" ToolTip.Tip="{x:Static res:Strings.More}">
          <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconMore}" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{x:Static res:Strings.ImportFromSda}" Command="{Binding ImportFromSdaCommand}" />
              <MenuItem Header="{x:Static res:Strings.ImportMaFiles}" Command="{Binding ImportMaFilesCommand}" />
              <Separator />
              <MenuItem Header="{x:Static res:Strings.Proxies}" Command="{Binding OpenProxiesCommand}" />
              <MenuItem Header="{x:Static res:Strings.Settings}" Command="{Binding OpenSettingsCommand}" />
              <Separator IsVisible="{Binding CanLock}" />
              <MenuItem Header="{x:Static res:Strings.LockApp}" InputGesture="Ctrl+L"
                        IsVisible="{Binding CanLock}" Command="{Binding LockCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- Shared 30 s timer -->
    <ProgressBar DockPanel.Dock="Top" Height="2" MinHeight="2" CornerRadius="0" IsVisible="{Binding HasAccounts}"
                 Minimum="0" Maximum="30" Value="{Binding SecondsRemaining}" />

    <Panel>
      <!-- Empty state -->
      <StackPanel IsVisible="{Binding !HasAccounts}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Classes="heading" HorizontalAlignment="Center" Text="{x:Static res:Strings.EmptyTitle}" />
        <TextBlock Classes="secondary" HorizontalAlignment="Center" Text="{x:Static res:Strings.EmptyBody}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button Theme="{DynamicResource SolidButton}" Classes="Primary"
                  Content="{x:Static res:Strings.ImportMaFiles}" Command="{Binding ImportMaFilesCommand}" />
          <Button Content="{x:Static res:Strings.ImportFromSda}" Command="{Binding ImportFromSdaCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- List + detail -->
      <Grid IsVisible="{Binding HasAccounts}" ColumnDefinitions="*,1.1*">
        <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AccountItemViewModel">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Height="24" Background="Transparent">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{x:Static res:Strings.CopyCode}"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyCodeCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="{x:Static res:Strings.Relogin}"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ReloginCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="{x:Static res:Strings.ChangeProxy}"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ChangeProxyCommand}"
                              CommandParameter="{Binding}" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                <PathIcon Grid.Column="1" Width="14" Height="14" Classes="warning" Data="{StaticResource SemiIconAlertCircle}"
                          IsVisible="{Binding HasProblem}" ToolTip.Tip="{Binding Problem}" />
                <TextBlock Grid.Column="2" Classes="caption accent" VerticalAlignment="Center"
                           Text="{Binding PendingCount}" IsVisible="{Binding HasPending}" />
                <TextBlock Grid.Column="3" Classes="code-list" VerticalAlignment="Center" Text="{Binding Code}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" Classes="divider-left" Padding="20,16">
          <StackPanel Spacing="4" DataContext="{Binding SelectedAccount}" x:DataType="vm:AccountItemViewModel"
                      IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Classes="title" Text="{Binding Name}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
              <TextBlock Classes="code-large" VerticalAlignment="Center" Text="{Binding Code}" />
              <Button Grid.Column="1" VerticalAlignment="Center"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyCodeCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="14" Height="14" Data="{StaticResource SemiIconCopy}" />
                  <TextBlock Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyLabel}" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Classes="caption"
                       Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SecondsLeftText}" />

            <!-- Problem banner: only when something is wrong -->
            <Border Classes="banner-warning" Margin="0,16,0,0" Padding="10,8" IsVisible="{Binding HasProblem}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <PathIcon Width="14" Height="14" Classes="warning" Data="{StaticResource SemiIconAlertCircle}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Problem}" />
                <Button Grid.Column="2" Theme="{DynamicResource BorderlessButton}" Classes="Primary" Padding="6,2"
                        IsVisible="{Binding ProblemNeedsLogin}" Content="{x:Static res:Strings.Fix}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ReloginCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="2" Theme="{DynamicResource BorderlessButton}" Classes="Primary" Padding="6,2"
                        IsVisible="{Binding !ProblemNeedsLogin}" Content="{x:Static res:Strings.Refresh}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RefreshConfirmationsCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </Border>

            <TextBlock Classes="title" Margin="0,24,0,4" Text="{x:Static res:Strings.Confirmations}" />
            <TextBlock Classes="hint" Text="{x:Static res:Strings.NothingToConfirm}" IsVisible="{Binding ShowNothingToConfirm}" />
            <ItemsControl ItemsSource="{Binding Confirmations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConfirmationItemViewModel">
                  <Border Classes="divider-bottom" Classes.danger-row="{Binding IsDangerous}" Padding="0,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Border Classes="conf-icon" VerticalAlignment="Top">
                        <Panel>
                          <PathIcon Width="16" Height="16" Classes="secondary" Data="{StaticResource SemiIconSync}" IsVisible="{Binding IsTrade}" />
                          <PathIcon Width="16" Height="16" Classes="secondary" Data="{StaticResource SemiIconShoppingBag}" IsVisible="{Binding IsMarket}" />
                          <PathIcon Width="16" Height="16" Classes="danger" Data="{StaticResource SemiIconKey}" IsVisible="{Binding IsDangerous}" />
                        </Panel>
                      </Border>

                      <StackPanel Grid.Column="1" Spacing="2">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Headline}" />
                          <TextBlock Grid.Column="1" Classes="caption hint" Text="{Binding Meta}" />
                        </Grid>
                        <TextBlock Classes="caption" TextWrapping="Wrap" MaxLines="2" Text="{Binding Summary}" />
                        <TextBlock Classes="caption danger" TextWrapping="Wrap" Text="{x:Static res:Strings.DangerousHint}"
                                   IsVisible="{Binding IsDangerous}" />
                        <TextBlock Classes="caption danger" Text="{Binding Error}"
                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <StackPanel Spacing="6" Margin="0,6,0,0" IsVisible="{Binding IsConfirmingTrade}">
                          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static res:Strings.AcceptTradeTitle}" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="Small" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelTradeCommand}" />
                            <Button Classes="Small Primary" Theme="{DynamicResource SolidButton}"
                                    Content="{x:Static res:Strings.AcceptTrade}" Command="{Binding AcceptCommand}" />
                          </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" IsVisible="{Binding IsPending}">
                          <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding PendingText}" />
                          <Button Theme="{DynamicResource BorderlessButton}" Classes="Small Primary" Padding="4,0"
                                  Content="{x:Static res:Strings.Undo}" Command="{Binding UndoCommand}" />
                        </StackPanel>
                        <TextBlock Classes="caption" Text="{x:Static res:Strings.Sending}" IsVisible="{Binding IsSending}" />
                      </StackPanel>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top" IsVisible="{Binding IsIdle}">
                        <Button Classes="quick accept" IsVisible="{Binding CanQuickAccept}" Command="{Binding AcceptCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Accept}" ToolTip.Tip="{x:Static res:Strings.Accept}">
                          <PathIcon Width="14" Height="14" Data="{StaticResource SemiIconTick}" />
                        </Button>
                        <Button Classes="quick reject" Command="{Binding RejectCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Reject}" ToolTip.Tip="{x:Static res:Strings.Reject}">
                          <PathIcon Width="14" Height="14" Data="{StaticResource SemiIconClose}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
