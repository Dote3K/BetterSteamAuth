<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BetterSteamAuth.App.ViewModels"
             xmlns:views="using:BetterSteamAuth.App.Views"
             xmlns:res="using:BetterSteamAuth.App.Resources"
             x:Class="BetterSteamAuth.App.Views.MainView"
             x:DataType="vm:MainViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+L" Command="{Binding LockCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCodeCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding OpenDetailsCommand}" />
  </UserControl.KeyBindings>
  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Classes="divider-bottom" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <TextBlock Classes="title" VerticalAlignment="Center" Text="{x:Static res:Strings.AllAccounts}" />
        <TextBox Grid.Column="1" MaxWidth="420" HorizontalAlignment="Stretch"
                 PlaceholderText="{x:Static res:Strings.Search}"
                 Text="{Binding SearchText}">
          <TextBox.InnerLeftContent>
            <PathIcon Width="14" Height="14" Margin="10,0,0,0" Data="{StaticResource SemiIconSearch}" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <Button Grid.Column="2" Padding="10,6" Command="{Binding OpenInboxCommand}" IsVisible="{Binding HasAccounts}"
                AutomationProperties.Name="{x:Static res:Strings.Confirmations}" ToolTip.Tip="{x:Static res:Strings.Confirmations}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="14" Height="14" Data="{StaticResource SemiIconCheckList}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Inbox.TotalCount}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Theme="{DynamicResource BorderlessButton}" Padding="8"
                AutomationProperties.Name="{x:Static res:Strings.More}" ToolTip.Tip="{x:Static res:Strings.More}">
          <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconMore}" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{x:Static res:Strings.ImportFromSda}" Command="{Binding ImportFromSdaCommand}" />
              <MenuItem Header="{x:Static res:Strings.ImportMaFiles}" Command="{Binding ImportMaFilesCommand}" />
              <MenuItem Header="{x:Static res:Strings.LinkNewAuthenticatorMenu}" Command="{Binding LinkNewCommand}" />
              <Separator />
              <MenuItem Header="{x:Static res:Strings.Proxies}" Command="{Binding OpenProxiesCommand}" />
              <MenuItem Header="{x:Static res:Strings.Settings}" Command="{Binding OpenSettingsCommand}" />
              <Separator IsVisible="{Binding CanLock}" />
              <MenuItem Header="{x:Static res:Strings.LockApp}" InputGesture="Ctrl+L"
                        IsVisible="{Binding CanLock}" Command="{Binding LockCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- Shared 30 s timer -->
    <ProgressBar DockPanel.Dock="Top" Height="2" MinHeight="2" CornerRadius="0" IsVisible="{Binding HasAccounts}"
                 Minimum="0" Maximum="30" Value="{Binding SecondsRemaining}" />

    <!-- Removed {name} · Undo -->
    <Border DockPanel.Dock="Bottom" Classes="divider-top bar" Padding="16,8" IsVisible="{Binding HasRemoved}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock VerticalAlignment="Center" Text="{Binding RemovedText}" />
        <Button Grid.Column="1" Theme="{DynamicResource BorderlessButton}" Classes="Primary"
                Content="{x:Static res:Strings.Undo}" Command="{Binding UndoRemoveCommand}" IsVisible="{Binding CanUndoRemove}" />
      </Grid>
    </Border>

    <Panel>
      <!-- Empty state -->
      <StackPanel IsVisible="{Binding !HasAccounts}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Classes="heading" HorizontalAlignment="Center" Text="{x:Static res:Strings.EmptyTitle}" />
        <TextBlock Classes="secondary" HorizontalAlignment="Center" Text="{x:Static res:Strings.EmptyBody}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button Theme="{DynamicResource SolidButton}" Classes="Primary"
                  Content="{x:Static res:Strings.ImportMaFiles}" Command="{Binding ImportMaFilesCommand}" />
          <Button Content="{x:Static res:Strings.LinkNewAuthenticator}" Command="{Binding LinkNewCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- List + detail -->
      <views:InboxView DataContext="{Binding Inbox}" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowInbox}" />
      <views:ConfirmationDetailView DataContext="{Binding Detail}" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).HasDetail}" />

      <Grid IsVisible="{Binding ShowAccounts}" ColumnDefinitions="*,1.1*">
        <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DoubleTapped="OnAccountDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AccountItemViewModel">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Height="32" Margin="4,0" Background="Transparent">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{x:Static res:Strings.OpenDetails}"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenDetailsCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="{x:Static res:Strings.CopyCode}"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyCodeCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="{x:Static res:Strings.Relogin}"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ReloginCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="{x:Static res:Strings.ChangeProxy}"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ChangeProxyCommand}"
                              CommandParameter="{Binding}" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                <PathIcon Grid.Column="1" Width="14" Height="14" Classes="warning" Data="{StaticResource SemiIconAlertCircle}"
                          IsVisible="{Binding HasProblem}" ToolTip.Tip="{Binding Problem}" />
                <Border Grid.Column="2" Classes="count-pill" VerticalAlignment="Center" IsVisible="{Binding HasPending}">
                  <TextBlock Classes="caption accent" HorizontalAlignment="Center" Text="{Binding PendingCount}" />
                </Border>
                <TextBlock Grid.Column="3" Classes="code-list" VerticalAlignment="Center" Text="{Binding Code}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" Classes="divider-left" Padding="28,22">
          <StackPanel Spacing="4" DataContext="{Binding SelectedAccount}" x:DataType="vm:AccountItemViewModel"
                      IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="title" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
              <Button Grid.Column="1" Theme="{DynamicResource BorderlessButton}" Classes="Primary Small" Padding="6,2"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenDetailsCommand}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{x:Static res:Strings.Details}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Details}" />
                  <PathIcon Width="10" Height="10" VerticalAlignment="Center" Data="{StaticResource SemiIconChevronRight}" />
                </StackPanel>
              </Button>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
              <TextBlock Classes="code-large" VerticalAlignment="Center" Text="{Binding Code}" />
              <Button Grid.Column="1" VerticalAlignment="Center"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyCodeCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="14" Height="14" Data="{StaticResource SemiIconCopy}" />
                  <TextBlock Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyLabel}" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Classes="caption"
                       Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SecondsLeftText}" />

            <!-- Problem banner: only when something is wrong -->
            <Border Classes="banner-warning" Margin="0,20,0,0" Padding="12,10" IsVisible="{Binding HasProblem}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <PathIcon Width="14" Height="14" Classes="warning" Data="{StaticResource SemiIconAlertCircle}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Problem}" />
                <Button Grid.Column="2" Theme="{DynamicResource BorderlessButton}" Classes="Primary" Padding="6,2"
                        IsVisible="{Binding ProblemNeedsLogin}" Content="{x:Static res:Strings.Fix}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ReloginCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="2" Theme="{DynamicResource BorderlessButton}" Classes="Primary" Padding="6,2"
                        IsVisible="{Binding IsLinkPending}" Content="{x:Static res:Strings.Fix}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).FinishLinkCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="2" Theme="{DynamicResource BorderlessButton}" Classes="Primary" Padding="6,2"
                        IsVisible="{Binding CanRefreshProblem}" Content="{x:Static res:Strings.Refresh}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RefreshConfirmationsCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </Border>

            <TextBlock Classes="title" Margin="0,32,0,6" Text="{x:Static res:Strings.Confirmations}" />
            <TextBlock Classes="hint" Text="{x:Static res:Strings.NothingToConfirm}" IsVisible="{Binding ShowNothingToConfirm}" />
            <ItemsControl ItemsSource="{Binding Confirmations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConfirmationItemViewModel">
                  <Border Classes="divider-bottom" Padding="0,16">
                    <views:ConfirmationRow />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
